[fs-uae]
amiga_model = A1200
kickstart_file = @KICK@
cpu = 68030
fast_memory = 8192
cpu_speed = 50
chip_memory = 2048
floppy_drive_0 = @ADF@
floppy_drive_count = 1
hard_drive_0 = @HDF@
hard_drive_0_controller = ide
video_sync = off
fullscreen = 0
window_width = 768
window_height = 576
automatic_input_grab = 0
joystick_port_1 = keyboard
joystick_port_0 = none
keyboard_key_x = action_joy_1_2nd_button
uae_sound_interpol = none
uae_sound_filter = off
[end]
